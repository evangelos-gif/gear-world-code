{
  "name": "gear-world-code",
  "private": true,
  "type": "module",
  "description": "Gear World sites: shared Worker engine, site configs, tools and tests",
  "scripts": {
    "test": "node --import ./tests/worker/test-clock.mjs --test tests/worker/*.test.mjs",
    "dev:tgw": "wrangler dev --config sites/tgw/wrangler.jsonc --local",
    "qa:local": "node tools/qa-gate.mjs http://127.0.0.1:8787",
    "layout:local": "node tools/layout-check.mjs http://127.0.0.1:8787"
  },
  "devDependencies": {
    "playwright": "1.56.0",
    "wrangler": "4.158.0"
  },
  "engines": {
    "node": ">=20"
  }
}
