{
  "expo": {
    "name": "Gear World",
    "slug": "gear-world",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": "gearworld",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#08111F",
    "ios": {
      "bundleIdentifier": "com.gearworldhub.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Gear World does not use your photos. Apple asks every app that includes image tools to explain photo access; the app never asks for or reads your photo library."
      }
    },
    "android": {
      "package": "com.gearworldhub.app",
      "adaptiveIcon": {
        "backgroundColor": "#030A1F",
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "backgroundImage": "./assets/brand/adaptive-background.png",
        "monochromeImage": "./assets/brand/adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#030A1F",
          "image": "./assets/brand/splash-icon.png",
          "imageWidth": 220
        }
      ],
      "expo-localization",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Gear World uses the microphone only when you tap the microphone button, to turn what you say into a product search. The app does not keep any recordings.",
          "speechRecognitionPermission": "Gear World uses speech recognition to turn what you say into a product search. The app does not keep any recordings."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "gear-world"
  }
}
