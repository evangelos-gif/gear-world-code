# Secrets: never commit
.dev.vars
.env
.env.*
*.pem
*.key

# Cloudflare / Node local state
.wrangler/
node_modules/

# Product data and reports stay on the PC (Awin feeds are not for public repos)
*.csv
*.csv.gz
*.sql.bak
gear-world-reports/
reports/

# Real Wrangler configs hold Cloudflare IDs: only the .example files are committed
sites/*/wrangler.jsonc
sites/*/.dev.vars
sites/*/wrangler.toml
sites/*/wrangler.*.toml
sites/*/wrangler.*.jsonc

# Outputs of the automatic checks
gwh-dist/
gwh-dist-pc/
gwh-pc-like/
gwh-photo-shots/
gwh-photo-report.txt
