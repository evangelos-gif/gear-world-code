// Travel Gear World - Wrangler config TEMPLATE.
// The real file (wrangler.jsonc) is created on the PC by a setup tool and is never committed,
// because it holds the Cloudflare database ID.
{
  "name": "travel-gear-world",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  // No public test address on the live Worker (F04, lessons L106): workers.dev and the version preview URLs are off,
  // so /out/ is reached only through the real domain and its security rules. A *-preview test Worker gets
  // workers.dev from its tool; a new site gets it on its test address before launch (the tool's preview step).
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "travel-gear-world",
      "database_id": "REPLACE_WITH_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  // Daily clean-up of old click records and rate-limit rows (privacy policy retention).
  "triggers": { "crons": ["17 3 * * *"] },
  // Search in other languages: Workers AI turns the words into English (src/lib/hub.js).
  "ai": { "binding": "AI" },
  // Poster QR scans (lessons L76): the private Worker that counts them (tools/poster-setup.ps1 makes it first).
  // The live config on the PC gets the same line from tools/poster-setup.ps1.
  "services": [{ "binding": "HUB", "service": "gear-world-hub" }, { "binding": "POSTERS", "service": "gear-world-posters" }],
  "observability": { "enabled": true }
  // Custom domain is added only at launch, with approval (ΕΓΚΡΙΝΩ VGW DOMAIN):
  // "routes": [
  //   { "pattern": "travelgearworld.com", "custom_domain": true },
  //   { "pattern": "www.travelgearworld.com", "custom_domain": true }
  // ]
}
