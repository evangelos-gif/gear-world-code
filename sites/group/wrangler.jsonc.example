// Gear World Group - Wrangler config TEMPLATE (no database, no secrets).
// tools/group-site.ps1 makes the real wrangler.jsonc on the PC and adds the domains only with approval.
{
  "name": "gear-world-group",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  // No public test address on the live Worker (F04, lessons L106): workers.dev and the version preview URLs are off,
  // so /out/ is reached only through the real domain and its security rules. A *-preview test Worker gets
  // workers.dev from its tool; a new site gets it on its test address before launch (the tool's preview step).
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "observability": { "enabled": true }
}
