# Gear World Hub (gearworldhub.com) - Worker gear-world-hub.
# Copy of C:\Users\vagge\gear-world-hub\wrangler.toml (24/10/2026) without the D1 database ID.
# The real file stays on the PC; tools fill the ID from `wrangler d1 list` when they deploy.
name = "gear-world-hub"
main = "worker.js"
compatibility_date = "2026-09-24"
# No public test address on the live Hub (security fixes F04, lessons L106): without these two lines every deploy
# switched gear-world-hub.<account>.workers.dev on again (no routes in this file). tools/gwh-hub-v2.ps1 -Step live
# writes the same two lines into the real wrangler.toml on the PC; the test Worker gets workers_dev = true instead.
workers_dev = false
preview_urls = false

[assets]
directory = "public"
binding = "ASSETS"
run_worker_first = true


[[d1_databases]]
binding = "gear_world_registry"
database_name = "gear-world-registry"
database_id = "REPLACE_WITH_DATABASE_ID"

[ai]
binding = "AI"

# Poster QR scans (lessons L76): the private Worker that counts them. tools/poster-setup.ps1 adds the same
# block to the real wrangler.toml on the PC.
[[services]]
binding = "POSTERS"
service = "gear-world-posters"

# Gear World email (step 5): every 10 minutes the Hub sends sign-ups that are still waiting to MailerLite
# (mailerlite.js syncPending). tools/gwh-mailerlite.ps1 adds the same block to the real wrangler.toml on the PC.
[triggers]
crons = ["*/10 * * * *"]
