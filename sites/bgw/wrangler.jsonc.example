// Biker Gear World - Wrangler config TEMPLATE.
// The real file (wrangler.jsonc) is created on the PC by a setup tool and is never committed,
// because it holds the Cloudflare database ID.
{
  "name": "biker-gear-world",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "biker-gear-world",
      "database_id": "REPLACE_WITH_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  // Daily clean-up of old click records and rate-limit rows (privacy policy retention).
  "triggers": { "crons": ["17 3 * * *"] },
  // Search in other languages: Workers AI turns the words into English (src/lib/hub.js).
  "ai": { "binding": "AI" },
  // Poster QR scans (lessons L76): the private Worker that counts them (tools/poster-setup.ps1 makes it first).
  // The live config on the PC gets the same line from tools/poster-setup.ps1.
  "services": [{ "binding": "POSTERS", "service": "gear-world-posters" }],
  "observability": { "enabled": true }
  // Custom domain is added only at launch, with approval (ΕΓΚΡΙΝΩ BGW DOMAIN):
  // "routes": [
  //   { "pattern": "bikergearworld.com", "custom_domain": true },
  //   { "pattern": "www.bikergearworld.com", "custom_domain": true }
  // ]
}
